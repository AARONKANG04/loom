{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:read-all",
    "fs:write-all",
    "fs:scope-home-recursive",
    "dialog:default",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "bash", "cmd": "bash", "args": true, "sidecar": false },
        { "name": "sh", "cmd": "sh", "args": true, "sidecar": false }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "bash", "cmd": "bash", "args": true, "sidecar": false },
        { "name": "sh", "cmd": "sh", "args": true, "sidecar": false }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "clipboard-manager:default",
    "store:default"
  ]
}